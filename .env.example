# Copie para .env e preencha. O arquivo .env nunca é versionado.

# Token de API do Duffel (painel do Duffel > Developers > Access tokens).
# O Duffel NÃO usa usuário/senha na API: você cria a conta com login e senha
# no site e gera um token. Tokens "duffel_test_..." retornam só a companhia
# fictícia "Duffel Airways"; para preços reais use um token "duffel_live_...".
DUFFEL_TOKEN=

# Chave da API do seats.aero (plano Pro, uso pessoal/não comercial; ~1.000 chamadas/dia).
# seats.aero > Settings > API. Retorna disponibilidade em milhas (em cache) de
# Smiles, Aeroplan, Flying Blue, United, American e outros programas.
SEATS_AERO_KEY=
# Opcional: limitar programas (ids separados por vírgula), ex.: smiles,aeroplan,flyingblue
# SEATS_AERO_PROGRAMAS=

# Quanto você considera que vale 1.000 milhas/pontos, em R$ (padrão do comparador).
MILHEIRO_PADRAO=20

# Valor do milheiro por programa (opcional; sobrescreve o padrão).
# MILHEIRO_SMILES=16
# MILHEIRO_LATAMPASS=25
# MILHEIRO_AEROPLAN=60
# MILHEIRO_MILESGO=30

# Navegador usado pelo robô: "chrome" (seu Chrome instalado, recomendado),
# "msedge" ou "chromium" (o do Playwright).
NAVEGADOR=chrome

# Segundos máximos de espera por resultados em cada site.
TEMPO_MAXIMO_SITE=90

# Intervalo mínimo (minutos) para repetir a MESMA busca no MESMO site.
# Evita acessos repetidos; use --forcar para ignorar.
CACHE_MINUTOS=15

# Opcional: caminho de um navegador específico (Chromium/Chrome/Brave/Edge).
# CAMINHO_NAVEGADOR=
